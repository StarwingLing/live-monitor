# Web 服务 systemd 单元
# 安装：cp bili-monitor-web.service /etc/systemd/system/ && systemctl daemon-reload
[Unit]
Description=bili-monitor web (FastAPI, v2.2 纯监控数据面——capture 已迁 replay)
After=network-online.target
Wants=network-online.target

[Service]
Environment=PYTHONUNBUFFERED=1
Type=simple
WorkingDirectory=/opt/bili-monitor
# root_path 通过 config.toml 的 server.root_path 配置（部署时设为 /bili-monitor）
ExecStart=/opt/bili-monitor/.venv/bin/uvicorn bili_monitor.web.app:app \
    --host 127.0.0.1 --port 8001
Restart=always
RestartSec=10
# 400M：web 进程本身 ~80M + v2.3.4 弹幕词云的 jieba 词典常驻 ~60-80M
#（分词峰值另计，单场 4.8 万条约 +30M 瞬时）。历史口径：v1.4 时代 500M
# 是为进程内 ffmpeg 转码留的（1080p→480p 单线程 x264 峰值 ~250-300M，
# 200M 曾致 13 秒一轮持续 13 小时的 OOM 崩溃循环）；v2.2 转码管线迁
# replay 后降 250M，v2.3.4 词云上调至 400M。
MemoryMax=400M

[Install]
WantedBy=multi-user.target
